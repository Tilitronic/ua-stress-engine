{
  "name": "ua-word-stress",
  "version": "1.2.2",
  "description": "Offline Ukrainian word stress lookup (~9 MB database). Zero dependencies. Works in browsers and Node.js.",
  "keywords": [
    "ukrainian",
    "nlp",
    "stress",
    "accent",
    "morphology",
    "ua"
  ],
  "license": "AGPL-3.0",
  "author": "Rostyslav Lukan <lkn.rostyslav@gmail.com>",
  "packageManager": "pnpm@9.0.0",
  "homepage": "https://github.com/Tilitronic/ua-stress-engine#ua-word-stress",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tilitronic/ua-stress-engine.git",
    "directory": "packages/ua-stress-web"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test",
    "generate:schema": "node scripts/generate-schema.mjs",
    "generate:types": "json2ts --input src/generated/schema.json --output src/generated/api-types.ts --no-additionalProperties",
    "generate": "pnpm generate:schema && pnpm generate:types",
    "check:drift": "node scripts/check-schema-drift.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
